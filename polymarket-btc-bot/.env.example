# Copy to .env and edit. Paper mode needs NO credentials.

# --- Mode ---
LIVE=0                     # keep 0 until you have watched paper mode for days

# --- Strategy ---
MIN_EDGE=0.06              # required model-vs-market mispricing (probability points)
MAX_SPREAD=0.10
MAX_PRICE=0.90
MIN_SECONDS_LEFT=20
MAX_SECONDS_LEFT=240

# --- Risk ---
STAKE_USDC=5
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_USDC=25
PAPER_START_BALANCE=200

# --- Live credentials (LIVE=1 only; NEVER commit the real .env) ---
# POLY_PRIVATE_KEY=0x...
# SIGNATURE_TYPE=1         # 1 if you log into Polymarket with email, 0 for plain wallet
# FUNDER=0x...             # your Polymarket deposit address (SIGNATURE_TYPE=1/2)
